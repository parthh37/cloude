# ---- Required -----------------------------------------------------------------
# Domain pointing at this server. Also add a wildcard record: *.<domain> -> same IP
# (no domain? use <server-ip>.sslip.io — e.g. 203.0.113.7.sslip.io — wildcard DNS for free)
CLOUDE_DOMAIN=cloude.example.com

# Login for the web UI (username defaults to "admin")
CLOUDE_ADMIN_PASSWORD=change-me-to-something-long

# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# ---- Claude credentials (optional here — you can also set them in Settings) ----
# Claude subscription: run `claude setup-token` in a Cloude terminal and paste it in Settings,
# or put it here. Or use an Anthropic API key instead.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ---- Optional -----------------------------------------------------------------
# CLOUDE_ADMIN_USER=admin
# GH_TOKEN=                       # clone/push private GitHub repos, use `gh`
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# LOG_LEVEL=warn
# CLOUDE_RESET_ADMIN_PASSWORD=true  # one-time: reset the admin password to CLOUDE_ADMIN_PASSWORD
