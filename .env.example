# ---- Required -----------------------------------------------------------------
# Domain pointing at this server. Also add a wildcard record: *.<domain> -> same IP
# (no domain? use <server-ip>.sslip.io — e.g. 203.0.113.7.sslip.io — wildcard DNS for free)
CLOUDE_DOMAIN=cloude.example.com

# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# One-time code for the browser setup wizard: open https://<domain>/setup#code=<this>
# to create your account. Leave it out and Cloude makes one and prints the link
# in its log (docker compose logs cloude). Useless once the account exists.
CLOUDE_SETUP_TOKEN=pick-a-long-random-string

# ---- Claude credentials (optional — the setup wizard and Settings can sign in for you) ----
# Claude subscription token from `claude setup-token`, or an Anthropic API key.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ---- Optional -----------------------------------------------------------------
# Skip the wizard's account step by creating the admin from here instead (scripted installs):
# CLOUDE_ADMIN_USER=admin
# CLOUDE_ADMIN_PASSWORD=
# GH_TOKEN=                       # clone/push private GitHub repos, use `gh`
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# LOG_LEVEL=warn
# CLOUDE_RESET_ADMIN_PASSWORD=true  # one-time: reset the admin password to CLOUDE_ADMIN_PASSWORD

# Virtual desktop (optional): X display number and the localhost-only VNC port behind /ws/desktop.
# CLOUDE_DESKTOP_DISPLAY=99
# CLOUDE_DESKTOP_VNC_PORT=5999
